# ─── Supabase (server-side only — never expose to client) ────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Anthropic (server-side only) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ─── Admin endpoint secret (POST /generate-puzzle) ───────────────────────────
# Generate with: openssl rand -hex 32
ADMIN_SECRET=your-random-secret-here

# ─── CORS (set to your Amplify Hosting domain in production) ─────────────────
# Leave as * for local development
ALLOWED_ORIGIN=*

# ─── Supabase (client-side — safe to expose, uses anon key + RLS) ─────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Vite client environment variables (prefix with VITE_) ───────────────────
# These are set AFTER deploying the Amplify backend.
# Copy the function URLs from the Amplify console or `npx ampx sandbox` output.

# DropIt
VITE_GET_PUZZLE_URL=https://xxxxxxxx.lambda-url.us-east-1.on.aws/
VITE_SUBMIT_SCORE_URL=https://xxxxxxxx.lambda-url.us-east-1.on.aws/
VITE_GET_LEADERBOARD_URL=https://xxxxxxxx.lambda-url.us-east-1.on.aws/

# Dead Letters
VITE_GET_DL_PUZZLE_URL=https://xxxxxxxx.lambda-url.us-east-1.on.aws/

# Optional: admin-only triggers (keep these private)
VITE_GENERATE_PUZZLE_URL=https://xxxxxxxx.lambda-url.us-east-1.on.aws/
VITE_GENERATE_DL_PUZZLE_URL=https://xxxxxxxx.lambda-url.us-east-1.on.aws/
